{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "(!data.exists() && newData.child('meta/hostUid').val() == auth.uid) || (data.exists() && data.child('meta/hostUid').val() == auth.uid)",
        ".validate": "newData.val() == null || (newData.hasChildren(['meta','players']) && newData.child('meta/code').val() == $room && newData.child('meta/createdAt').isNumber() && newData.child('meta/hostUid').isString())",
        "players": {
          ".write": "auth != null",
          ".validate": "newData.numChildren() <= (newData.parent().child('meta/kind').val() == 'tournament' ? newData.parent().child('tournament/config/maxEntrants').val() + 65 : 6)",
          "$player": {
            ".validate": "(newData.val() == null && (data.child('authUid').val() == auth.uid || newData.parent().parent().child('meta/hostUid').val() == auth.uid)) || (newData.hasChildren(['authUid','name','slot','role']) && (newData.child('authUid').val() == auth.uid || newData.parent().parent().child('meta/hostUid').val() == auth.uid))"
          }
        },
        "meta": {
          ".write": "data.parent().child('meta/hostUid').val() == auth.uid"
        },
        "tournament": {
          ".write": "data.parent().child('meta/hostUid').val() == auth.uid"
        },
        "watchRequests": {
          "$player": {
            ".write": "auth != null && (data.parent().parent().child('players').child($player).child('authUid').val() == auth.uid || data.parent().parent().child('meta/hostUid').val() == auth.uid)",
            ".validate": "newData.val() == null || newData.isString()"
          }
        }
      }
    },
    "signals": {
      "$room": {
        "$signal": {
          ".read": "auth != null && (data.child('authUid').val() == auth.uid || data.child('hostUid').val() == auth.uid)",
          ".write": "auth != null && ((data.exists() && (data.child('authUid').val() == auth.uid || data.child('hostUid').val() == auth.uid)) || (!data.exists() && root.child('rooms').child($room).child('meta/hostUid').val() == auth.uid && newData.child('hostUid').val() == auth.uid && newData.child('authUid').isString()))",
          ".validate": "newData.val() == null || newData.hasChildren(['authUid','hostUid','offer'])"
        }
      }
    }
  }
}
